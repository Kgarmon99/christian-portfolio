{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/compound", "destination": "/api/compound.js" }
  ],
  "headers": [
    {
      "source": "/api/compound",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/agents",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
